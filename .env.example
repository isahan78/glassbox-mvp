# GlassBox MVP Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
# -----------------
# Model to use for inference (default: gpt2-small)
# Options: gpt2-small, gpt2-medium, gpt2-large, gpt2-xl, meta-llama/Llama-2-7b-hf, mistral-7b
GLASSBOX_MODEL=gpt2-small

# API server host (default: 0.0.0.0)
GLASSBOX_HOST=0.0.0.0

# API server port (default: 8000)
GLASSBOX_PORT=8000

# Logging Configuration
# ---------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
GLASSBOX_LOG_LEVEL=INFO

# Log format: "simple" for development (colorful), "json" for production (structured)
# Use "json" for production to enable log aggregation with ELK, Datadog, etc.
GLASSBOX_LOG_FORMAT=simple

# API Key (Security)
# ------------------
# Set this to enable API authentication
# If not set, API runs in development mode (no authentication required)
# Generate a secure key with: openssl rand -hex 32
# GLASSBOX_API_KEY=your_secure_api_key_here

# CORS Configuration
# -----------------
# Comma-separated list of allowed origins for CORS
# For development, you can use localhost URLs
# For production, specify your frontend URLs
GLASSBOX_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# HuggingFace Configuration (optional)
# ------------------------------------
# Only needed if using Llama or other gated models
# HF_TOKEN=your_huggingface_token_here
