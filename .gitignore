# Navigate to your project root
cd glassbox-mvp

# Create .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data & Model Files
data/traces/
*.json
*.pth
*.pt
*.bin
*.safetensors
models/
checkpoints/

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Distribution
*.tar.gz
*.whl

# HuggingFace cache (optional - comment out if you want to cache models)
~/.cache/huggingface/

# OS specific
Thumbs.db
.Trash-*
EOF